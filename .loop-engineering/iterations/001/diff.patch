+func artifact_metadata(path) {
+    if path == "" { return {"ok": true, "value": null} }
+    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "unsafe_artifact", "error": "artifact must be a regular non-symlink file"} }
+    if file_size(path) > 67108864 { return {"ok": false, "code": "artifact_too_large", "error": "artifact exceeds 64 MiB"} }
+    return {"ok": true, "value": {"path": path, "sha256": sha256_file(path), "bytes": file_size(path)}}
