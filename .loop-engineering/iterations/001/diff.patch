+func flag(parsed, name, fallback) {
+    if has_key(parsed["flags"], name) == 1 { return parsed["flags"][name] }
+    return fallback
+}
+
+func command_name(argv, commands) {
+    if len(argv) == 0 { return "help" }
+    if argv[0] == "--help" { return "help" }
+    if argv[0] == "--version" { return "version" }
+    if len(argv) > 1 && has(commands, argv[0] + " " + argv[1]) { return argv[0] + " " + argv[1] }
+    return argv[0]
+}
+
+func command_tokens(argv, command) {
+    if command == "help" || (len(argv) > 0 && starts_with(argv[0], "--")) { return [] }
+    if contains(command, " ") == 1 { return slice(argv, 2, len(argv)) }
+    return slice(argv, 1, len(argv))
+}
+
+func load_config(path) {
+    if path == "" { return {"ok": true, "value": {}} }
+    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "config_not_found", "error": "config must be a regular file"} }
+    if file_size(path) > 65536 { return {"ok": false, "code": "config_too_large", "error": "config exceeds 64 KiB"} }
+    config_result := parse_object(read_file(path), "config"); if !config_result["ok"] { return config_result }
+    for key in keys(config_result["value"]) { if !has(["state", "actor", "limit"], key) { return {"ok": false, "code": "unknown_config_key", "error": "unknown config key: " + key} } }
+    return config_result
+}
+
+func setting(parsed, config, name, fallback) {
+    value := flag(parsed, name, null)
+    if type(value) != "null" && value != "" { return value }
+    return get(config, name, fallback)
+}
+
+func read_payload(parsed) {
+    path := flag(parsed, "input", "")
+    if path == "" { return {"ok": true, "value": {"schema_version": "1.0.0"}} }
+    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "input_not_found", "error": "input must be a regular file"} }
+    if file_size(path) > 1048576 { return {"ok": false, "code": "input_too_large", "error": "input exceeds 1 MiB"} }
+    parsed_payload := parse_object(read_file(path), "input"); if !parsed_payload["ok"] { return parsed_payload }
+    payload := parsed_payload["value"]
+    schema := get(payload, "schema_version", "1.0.0")
+    if type(schema) != "string" || !starts_with(schema, "1.") { return {"ok": false, "code": "incompatible_schema", "error": "input schema major must be 1"} }
+    sensitive := find_sensitive_key(payload, "")
+    if sensitive != "" { return {"ok": false, "code": "secret_rejected", "error": "sensitive field is not allowed: " + sensitive} }
+    return {"ok": true, "value": payload}
+}
