from src.storage import initialize, save_new, load_record
from src.common import get
root := "/tmp/galleypack-concurrency-" + uuid_v4()
metadata := {"tool":"concurrency-test", "contract_version":"1.0.0"}
assert(initialize(root, metadata)["ok"], "initialize shared state")
runtime := args()[0]
// Fixed shell orchestration only; workers and all assertions stay in Kujo.
launched := spawn_process(["sh", "-c", "i=0; while [ \"$i\" -lt 24 ]; do \"$1\" run tests/concurrency_worker.kujo -- \"$2\" \"$i\" > \"$2/result-$i.json\" & i=$((i+1)); done; wait", "galleypack-contention", runtime, root], {"timeout_ms":30000,"max_output_bytes":4096})
assert(launched.exitcode == 0, "workers completed")
mut winners := 0
for index in range(24) {
    result := parse_json(read_file(root + "/result-" + to_string(index) + ".json"))
    if result["ok"] { winners = winners + 1 } else { assert(get(result,"code","") == "duplicate_id" || get(result,"code","") == "write_conflict", "losers fail with expected conflict") }
    delete_file(root + "/result-" + to_string(index) + ".json")
}
assert(winners == 1, "exactly one concurrent writer commits")
assert(len(list_dir(root + "/history")) == 1, "exactly one audit event")
assert(len(list_dir(root + "/locks")) == 0, "no leaked locks")
record := load_record(root, "artifact-contended")
event := parse_json(read_file(root + "/history/" + list_dir(root + "/history")[0]))
assert(record["ok"] && event["record_sha256"] == record["checksum"], "event checksum matches winning record")
for dir in ["records", "history", "locks"] { for name in list_dir(root + "/" + dir) { delete_file(root + "/" + dir + "/" + name) }; os_rmdir(root + "/" + dir) }
delete_file(root + "/metadata.json"); os_rmdir(root)
print("24-writer contention: one winner, matching event, no leaked locks")
