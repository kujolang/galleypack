from tests.support import cleanup
from src.storage import initialize, save_new

mut passed := 0
mut failed := 0
func check(ok, label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }

root := "/tmp/storage-transaction-" + uuid_v4()
metadata := {"schema_version":"1.0.0","tool":"storage-test","tool_version":"0.2.0","contract_version":"1.0.0","created_at":"2026-08-14T00:00:00Z"}
check(initialize(root, metadata)["ok"], "storage initialized")
record := {"schema_version":"1.0.0","tool_version":"0.2.0","contract_version":"1.0.0","id":"record-transaction","record_type":"test","command":"test","actor":"test-actor","created_at":"2026-08-14T00:00:01Z","provenance":[],"payload":{}}
event_path := root + "/history/" + substring(sha256(record["created_at"] + "\n" + record["id"]), 0, 32) + ".json"
write_file(event_path, "{}", true)
conflict := save_new(root, record)
check(!conflict["ok"] && conflict["code"] == "history_conflict", "history conflict fails before record persistence")
check(!path_is_file(root + "/records/" + record["id"] + ".json"), "history conflict leaves no partial record")
delete_file(event_path)
check(save_new(root, record)["ok"], "clean retry persists record and audit event")


// A dangling event is rejected before intent or record publication.
record["id"] = "record-rollback"
rollback_event := root + "/history/" + substring(sha256(record["created_at"] + "\n" + record["id"]), 0, 32) + ".json"
linked := spawn_process(["ln", "-s", root + "/missing", rollback_event], {"timeout_ms":5000,"max_output_bytes":4096})
check(linked.exitcode == 0, "rollback fixture created")
rolled_back := save_new(root, record)
check(!rolled_back["ok"] && rolled_back["code"] == "history_conflict", "dangling history conflict is explicit")
check(!file_exists(root + "/records/record-rollback.json"), "late history failure rolls back record")
check(len(list_dir(root + "/locks")) == 0, "late history failure releases lock")

cleanup(root)
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
