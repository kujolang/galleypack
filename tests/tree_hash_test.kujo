from src.hardening import streaming_tree_hash, checksum_manifest
from tests.support import cleanup
root := "/tmp/galleypack-tree-contract-" + uuid_v4(); create_dir(root)
write_file(root + "/empty", "", true)
write_file(root + "/unicode", "é🙂", true)
write_binary_file(root + "/binary", bytes([0,255,1,128]))
rows := [{"path":"binary","bytes":4,"sha256":sha256_file(root + "/binary")}, {"path":"empty","bytes":0,"sha256":sha256("")}, {"path":"unicode","bytes":6,"sha256":sha256("é🙂")}]
result := streaming_tree_hash(root, ["unicode","empty","binary"], 10)
assert(result["ok"] && result["files"] == 3 && result["streaming"], "binary, empty and Unicode tree")
assert(result["tree_sha256"] == checksum_manifest(rows, "")["tree_sha256"], "exact stable checksum serialization and byte counts")
for entry in ["missing", "../outside", "empty/child"] { assert(!streaming_tree_hash(root, [entry], 10)["ok"], "invalid tree entry rejected") }
create_dir(root + "/directory")
assert(!streaming_tree_hash(root, ["directory"], 10)["ok"], "directory rejected")
for target in ["unicode", "missing", "directory"] {
    link := root + "/link-" + target
    made := spawn_process(["ln","-s",root + "/" + target,link], {"timeout_ms":5000,"max_output_bytes":4096})
    assert(made.exitcode == 0, "symlink fixture")
    assert(!streaming_tree_hash(root, ["link-" + target], 10)["ok"], "symlink leaf rejected")
}
assert(!streaming_tree_hash(root, ["link-directory/file"], 10)["ok"], "symlink ancestor rejected")
pipe := spawn_process(["mkfifo",root + "/pipe"], {"timeout_ms":5000,"max_output_bytes":4096})
assert(pipe.exitcode == 0 && !streaming_tree_hash(root, ["pipe"], 10)["ok"], "FIFO rejected without blocking")
// Sparse regular files make byte-limit coverage cheap in disk space.
sparse := spawn_process(["dd","if=/dev/zero","of=" + root + "/large","bs=1","count=0","seek=67108865"], {"timeout_ms":5000,"max_output_bytes":4096})
assert(sparse.exitcode == 0, "oversize sparse fixture")
over := streaming_tree_hash(root, ["large"], 10)
assert(!over["ok"] && over["error"] == "tree exceeds 64 MiB per file or 1 GiB total", "oversize retains error contract")
delete_file(root + "/large")
exact := spawn_process(["dd","if=/dev/zero","of=" + root + "/large","bs=1","count=0","seek=67108864"], {"timeout_ms":5000,"max_output_bytes":4096})
assert(exact.exitcode == 0, "exact-bound sparse fixture")
mut paths := []
for index in range(16) {
    name := "part-" + to_string(100 + index)
    linked := spawn_process(["ln",root + "/large",root + "/" + name], {"timeout_ms":5000,"max_output_bytes":4096})
    assert(linked.exitcode == 0, "aggregate-bound hardlink fixture")
    paths = push(paths, name)
}
write_file(root + "/z-empty", "", true)
paths = push(paths, "z-empty")
assert(streaming_tree_hash(root, paths, 20)["ok"], "exact 64 MiB files, 1 GiB total, then empty file accepted")
write_file(root + "/z-over", "x", true)
aggregate := streaming_tree_hash(root, push(paths, "z-over"), 20)
assert(!aggregate["ok"] && aggregate["error"] == "tree exceeds 64 MiB per file or 1 GiB total", "one byte beyond aggregate ceiling rejected")
cleanup(root)
print("Tree hashing passed: stable binary/Unicode/empty receipts, unsafe paths, links, FIFO and byte bounds")
