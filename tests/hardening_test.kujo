from src.hardening import materialize_review_package, checksum_manifest, streaming_tree_hash, archive_adapter_plan, object_store_conformance, local_claim_delta, semantic_delta
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
root:="/private/tmp/galleypack-review-"+uuid_v4();manifest:={"entries":[{"path":"manifest.json","content":"{}\n"},{"path":"artifacts/story.md","content":"story\n"},{"path":"reviews/index.json","content":"[]\n"},{"path":"evidence/index.json","content":"[]\n"}]};built:=materialize_review_package(manifest,root);check(built["ok"]&&path_is_file(root+"/reviews/index.json"),"materialize review package");check(!materialize_review_package({"entries":[{"path":"../escape","content":"x"}]},root+"-bad")["ok"],"path confinement")
tree:=streaming_tree_hash(root,["manifest.json","artifacts/story.md","reviews/index.json","evidence/index.json"],100);check(tree["ok"]&&tree["files"]==4,"streaming tree hash");signed:=checksum_manifest(built["entries"],"fixture-key-123456");check(signed["ok"]&&len(signed["signature"])==64,"signed manifest")
adapter:={"id":"fixture-archive","offline":true,"normalizes_timestamps":true,"sorts_entries":true};for format in ["tar","zip"]{check(archive_adapter_plan(format,["reviews/index.json","manifest.json"],adapter)["reproducible"],"archive "+format)}
check(object_store_conformance(parse_json(read_file("fixtures/adapters/object-store.json")))["ok"],"object store")
left:={"claim-a":{"text":"old"},"claim-b":{"text":"same"}};right:={"claim-a":{"text":"new"},"claim-b":{"text":"same"},"claim-c":{"text":"added"}};delta:=local_claim_delta(left,right);check(delta["changed"]==["claim-a"]&&delta["added"]==["claim-c"],"local delta");check(semantic_delta(left,right,{"offline":true,"semantic":[{"claim_id":"claim-a","relation":"refined"}]})["local_path_preserved"],"semantic delta")
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
