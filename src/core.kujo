from src.args import parse_args
from src.common import get, has, canonical_json, parse_object, safe_id, valid_timestamp, find_sensitive_key, bounded_int, envelope
from src.profile import profile
from src.domain import record_type, id_prefix, validate_command
from src.storage import initialize, save_new, load_record, list_records, validate_state_path

func flag(parsed, name, fallback) {
    if has_key(parsed["flags"], name) == 1 { return parsed["flags"][name] }
    return fallback
}

func command_name(argv, commands) {
    if len(argv) == 0 { return "help" }
    if argv[0] == "--help" { return "help" }
    if argv[0] == "--version" { return "version" }
    if len(argv) > 1 && has(commands, argv[0] + " " + argv[1]) { return argv[0] + " " + argv[1] }
    return argv[0]
}

func command_tokens(argv, command) {
    if command == "help" || (len(argv) > 0 && starts_with(argv[0], "--")) { return [] }
    if contains(command, " ") == 1 { return slice(argv, 2, len(argv)) }
    return slice(argv, 1, len(argv))
}

func load_config(path) {
    if path == "" { return {"ok": true, "value": {}} }
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "config_not_found", "error": "config must be a regular file"} }
    if file_size(path) > 65536 { return {"ok": false, "code": "config_too_large", "error": "config exceeds 64 KiB"} }
    config_result := parse_object(read_file(path), "config"); if !config_result["ok"] { return config_result }
    for key in keys(config_result["value"]) { if !has(["state", "actor", "limit"], key) { return {"ok": false, "code": "unknown_config_key", "error": "unknown config key: " + key} } }
    return config_result
}

func setting(parsed, config, name, fallback) {
    value := flag(parsed, name, null)
    if type(value) != "null" && value != "" { return value }
    return get(config, name, fallback)
}

func read_payload(parsed) {
    path := flag(parsed, "input", "")
    if path == "" { return {"ok": true, "value": {"schema_version": "1.0.0"}} }
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "input_not_found", "error": "input must be a regular file"} }
    if file_size(path) > 1048576 { return {"ok": false, "code": "input_too_large", "error": "input exceeds 1 MiB"} }
    parsed_payload := parse_object(read_file(path), "input"); if !parsed_payload["ok"] { return parsed_payload }
    payload := parsed_payload["value"]
    schema := get(payload, "schema_version", "1.0.0")
    if type(schema) != "string" || !starts_with(schema, "1.") { return {"ok": false, "code": "incompatible_schema", "error": "input schema major must be 1"} }
    sensitive := find_sensitive_key(payload, "")
    if sensitive != "" { return {"ok": false, "code": "secret_rejected", "error": "sensitive field is not allowed: " + sensitive} }
    return {"ok": true, "value": payload}
}

func artifact_metadata(path) {
    if path == "" { return {"ok": true, "value": null} }
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "unsafe_artifact", "error": "artifact must be a regular non-symlink file"} }
    if file_size(path) > 67108864 { return {"ok": false, "code": "artifact_too_large", "error": "artifact exceeds 64 MiB"} }
    return {"ok": true, "value": {"path": path, "sha256": sha256_file(path), "bytes": file_size(path)}}
}

func create_record(command, parsed, config, p) {
    state := setting(parsed, config, "state", p["default_state"])
    initialized := initialize(state, {"schema_version": "1.0.0", "tool": p["slug"], "tool_version": p["version"], "contract_version": p["contract_version"], "created_at": now_utc()})
    if !initialized["ok"] { return initialized }
    input := read_payload(parsed); if !input["ok"] { return input }; payload := input["value"]
    actor := setting(parsed, config, "actor", "")
    if type(actor) != "string" || trim(actor) == "" || len(actor) > 256 { return {"ok": false, "code": "actor_required", "error": "mutating commands require a bounded --actor or config actor"} }
    timestamp := flag(parsed, "timestamp", now_utc())
    if !valid_timestamp(timestamp) { return {"ok": false, "code": "invalid_timestamp", "error": "timestamp must be RFC 3339 UTC"} }
    artifact := artifact_metadata(flag(parsed, "path", "")); if !artifact["ok"] { return artifact }
    domain_error := validate_command(command, payload, artifact["value"])
    if domain_error != "" { code := "domain_validation"; if starts_with(domain_error, "unsupported:") { code = "unsupported" }; return {"ok": false, "code": code, "error": domain_error} }
    prefix := id_prefix(command); id := flag(parsed, "id", "")
    if id == "" { id = prefix + "-" + substring(sha256(p["slug"] + "\n" + command + "\n" + actor + "\n" + timestamp + "\n" + canonical_json(payload)), 0, 20) }
    if !safe_id(id) || !starts_with(id, prefix + "-") { return {"ok": false, "code": "unsafe_id", "error": "id must use prefix " + prefix + "- and contain only lowercase letters, digits, and hyphens"} }
    record := {"schema_version": "1.0.0", "tool_version": p["version"], "contract_version": p["contract_version"], "id": id, "record_type": record_type(command), "command": command, "actor": actor, "created_at": timestamp, "provenance": get(payload, "provenance", []), "payload": payload}
    if type(artifact["value"]) == "dict" { record["artifact"] = artifact["value"] }
    if flag(parsed, "dry-run", false) == true { return {"ok": true, "value": {"dry_run": true, "record": record}} }
    stored := save_new(state, record); if !stored["ok"] { return stored }
    return {"ok": true, "value": {"record": record, "storage": stored["value"]}}
}

func validate_record(record, p) {
    for key in ["schema_version", "tool_version", "contract_version", "id", "record_type", "command", "actor", "created_at", "provenance", "payload"] {
        if has_key(record, key) == 0 { return {"ok": false, "code": "missing_field", "error": "record missing field: " + key} }
    }
    if record["schema_version"] != "1.0.0" || record["contract_version"] != p["contract_version"] { return {"ok": false, "code": "incompatible_record", "error": "record contract is incompatible"} }
    if !safe_id(record["id"]) || !valid_timestamp(record["created_at"]) { return {"ok": false, "code": "invalid_record", "error": "record id or timestamp is invalid"} }
    if type(record["payload"]) != "dict" || type(record["provenance"]) != "array" { return {"ok": false, "code": "invalid_record", "error": "payload/provenance shape is invalid"} }
    artifact := get(record, "artifact", null)
    if type(artifact) == "dict" {
        path := get(artifact, "path", "")
        if path == "" || !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "artifact_missing", "error": "bound artifact is missing or unsafe"} }
        if sha256_file(path) != get(artifact, "sha256", "") { return {"ok": false, "code": "checksum_drift", "error": "bound artifact checksum drift detected"} }
    }
    error := validate_command(record["command"], record["payload"], get(record, "artifact", null))
    if error != "" { return {"ok": false, "code": "domain_validation", "error": error} }
    return {"ok": true}
}

func export_result(value, parsed, p) {
    output := flag(parsed, "output", "")
    if output == "" { return {"ok": true, "value": value} }
    if file_exists(output) && path_is_symlink(output) { return {"ok": false, "code": "unsafe_output", "error": "output symlinks are not allowed"} }
    if file_exists(output) && flag(parsed, "force", false) != true { return {"ok": false, "code": "output_exists", "error": "output exists; use --force only for intentional safe replacement"} }
    rendered := to_json_pretty(envelope(true, value, null, null, p["version"], p["contract_version"])) + "\n"
    if len(rendered) > 8388608 { return {"ok": false, "code": "output_too_large", "error": "output exceeds 8 MiB"} }
    write_file_atomic(output, rendered, true)
    return {"ok": true, "value": {"output": output, "bytes": len(rendered), "sha256": sha256(rendered)}}
}

export func dispatch(command, parsed) {
    p := profile(); config_result := load_config(flag(parsed, "config", "")); if !config_result["ok"] { return config_result }; config := config_result["value"]
    state := setting(parsed, config, "state", p["default_state"])
    if command == "init" { return initialize(state, {"schema_version": "1.0.0", "tool": p["slug"], "tool_version": p["version"], "contract_version": p["contract_version"], "created_at": now_utc()}) }
    if command == "version" { return {"ok": true, "value": {"tool": p["slug"], "version": p["version"], "contract_version": p["contract_version"], "minimum_kujo": "1.0.1"}} }
    if command == "doctor" {
        state_error := validate_state_path(state); listing := {"records": [], "warnings": [], "truncated": false}
        if state_error == "" { listing = list_records(state, "", "", 1000) }
        healthy := state_error == "" && len(listing["warnings"]) == 0
        mut code := null; mut error := null
        if state_error != "" { code = "unsafe_state"; error = state_error }
        if state_error == "" && len(listing["warnings"]) > 0 { code = "corrupt_state"; error = "one or more records are unreadable" }
        return {"ok": healthy, "code": code, "error": error, "value": {"healthy": healthy, "tool": p["slug"], "version": p["version"], "minimum_kujo": "1.0.1", "state": state, "record_count": len(listing["records"]), "corrupt_records": listing["warnings"], "limits": {"input_bytes": 1048576, "record_bytes": 1048576, "artifact_bytes": 67108864, "list_records": 1000}, "limitations": p["limitations"]}}
    }
    if has(p["show_commands"], command) {
        id := flag(parsed, "id", ""); if id == "" { return {"ok": false, "code": "id_required", "error": "show requires --id"} }
        return load_record(state, id)
    }
    if has(p["list_commands"], command) {
        limit_result := bounded_int(setting(parsed, config, "limit", 100), 100, 1, 1000); if !limit_result["ok"] { return limit_result }
        kind := flag(parsed, "type", get(p["list_kinds"], command, ""))
        listing := list_records(state, kind, flag(parsed, "after", ""), limit_result["value"])
        return {"ok": true, "value": listing}
    }
    if has(p["diff_commands"], command) {
        left_id := flag(parsed, "id", ""); right_id := flag(parsed, "other-id", "")
        if left_id == "" || right_id == "" { return {"ok": false, "code": "ids_required", "error": "comparison requires --id and --other-id"} }
        left := load_record(state, left_id); if !left["ok"] { return left }
        right := load_record(state, right_id); if !right["ok"] { return right }
        left_artifact := get(left["value"], "artifact", {}); right_artifact := get(right["value"], "artifact", {})
        return {"ok": true, "value": {"left_id": left_id, "right_id": right_id, "records_equal": canonical_json(left["value"]["payload"]) == canonical_json(right["value"]["payload"]), "left_record_sha256": left["checksum"], "right_record_sha256": right["checksum"], "left_artifact_sha256": get(left_artifact, "sha256", null), "right_artifact_sha256": get(right_artifact, "sha256", null), "artifact_equal": get(left_artifact, "sha256", null) == get(right_artifact, "sha256", null)}}
    }
    if has(p["validate_commands"], command) {
        id := flag(parsed, "id", "")
        if id != "" { loaded := load_record(state, id); if !loaded["ok"] { return loaded }; checked := validate_record(loaded["value"], p); if !checked["ok"] { return checked }; return {"ok": true, "value": {"valid": true, "id": id, "checksum": loaded["checksum"]}} }
        listing := list_records(state, "", "", 1000); mut invalid := []
        for record in listing["records"] { checked := validate_record(record, p); if !checked["ok"] { invalid = push(invalid, {"id": record["id"], "code": checked["code"], "error": checked["error"]}) } }
        valid := len(invalid) == 0 && len(listing["warnings"]) == 0
        mut code := null; mut error := null
        if !valid { code = "validation_failed"; error = "one or more records failed validation" }
        return {"ok": valid, "code": code, "error": error, "value": {"valid": valid, "checked": len(listing["records"]), "invalid": invalid, "storage_warnings": listing["warnings"], "truncated": listing["truncated"]}}
    }
    if has(p["export_commands"], command) {
        limit_result := bounded_int(setting(parsed, config, "limit", 1000), 1000, 1, 1000); if !limit_result["ok"] { return limit_result }
        listing := list_records(state, flag(parsed, "type", ""), flag(parsed, "after", ""), limit_result["value"])
        return export_result({"schema_version": "1.0.0", "tool": p["slug"], "records": listing["records"], "warnings": listing["warnings"], "truncated": listing["truncated"]}, parsed, p)
    }
    return create_record(command, parsed, config, p)
}

func usage(p) {
    return p["name"] + " " + p["version"] + "\n\n" + p["description"] + "\n\nCommands:\n  " + join(p["commands"], "\n  ") + "\n\nCommon flags:\n  --state PATH       Local state directory\n  --config FILE      JSON defaults for state, actor, and limit\n  --input FILE       JSON command payload (1 MiB maximum)\n  --actor ID         Required for mutations\n  --timestamp UTC    Deterministic RFC 3339 timestamp\n  --id ID            Explicit stable record ID\n  --path FILE        Bounded artifact attachment\n  --type TYPE        Record filter for list/export\n  --after ID         Pagination cursor\n  --limit N          1..1000 records\n  --output FILE      Atomic JSON export\n  --force            Replace only an explicitly named safe output\n  --dry-run          Validate without writing\n  --json             Stable output envelope"
}

export func main(argv) {
    p := profile(); command := command_name(argv, p["commands"])
    if command == "help" { print(usage(p)); return 0 }
    if !has(p["commands"], command) { eprint(p["name"] + ": unknown command: " + command); return 2 }
    parsed := parse_args(command_tokens(argv, command), ["json", "dry-run", "force"])
    if len(parsed["errors"]) > 0 { eprint(p["name"] + ": " + parsed["errors"][0]); return 2 }
    allowed := ["state", "config", "input", "id", "other-id", "actor", "timestamp", "path", "type", "after", "limit", "output", "json", "dry-run", "force"]
    for name in keys(parsed["flags"]) { if !has(allowed, name) { eprint(p["name"] + ": unknown flag --" + name); return 2 } }
    if len(parsed["positionals"]) > 0 { eprint(p["name"] + ": unexpected positional argument: " + parsed["positionals"][0]); return 2 }
    result := dispatch(command, parsed)
    output := envelope(result["ok"], get(result, "value", null), get(result, "error", null), get(result, "code", null), p["version"], p["contract_version"])
    if flag(parsed, "json", false) { print(to_json_pretty(output)) }
    else if result["ok"] { print(p["name"] + ": ok\n" + to_json_pretty(get(result, "value", null))) }
    else { eprint(p["name"] + ": " + get(result, "error", "operation failed") + " [" + get(result, "code", "unknown") + "]") }
    if result["ok"] { return 0 }
    return 1
}
