from cli import parse_args
SLUG:="galleypack";NAME:="GalleyPack";VERSION:="0.1.0";CONTRACT:="1.0.0";DEFAULT_STATE:=".galleypack";PREFIX:="artifact";COMMANDS:=split("add,relate,evidence attach,review attach,claims compare,build,freeze,validate,diff,show,export,doctor,version,init,report,history",",")
func get(d,k,f){if type(d)=="dict"&&has_key(d,k)==1{return d[k]};return f}
func has(a,v){for x in a{if x==v{return true}};return false}
func flag(p,k,f){if has_key(p["flags"],k)==1{return p["flags"][k]};return f}
func safe(v){return type(v)=="string"&&v!=""&&v!="."&&v!=".."&&contains(v,"/")==0&&contains(v,"\\")==0}
func parent(p){mut i:=len(p)-1;while i>=0{if substring(p,i,i+1)=="/"{if i==0{return "/"};return substring(p,0,i)};i=i-1};return "."}
func tree(p){if p==""||p=="."{return};parts:=split(p,"/");cur:="";if starts_with(p,"/"){cur="/"};for part in parts{if part!=""&&part!="."{if cur=="/"{cur="/"+part}else if cur==""{cur=part}else {cur=cur+"/"+part};if !path_is_dir(cur){create_dir(cur)}}}}
func atomic(p,t){tree(parent(p));tmp:=p+".tmp-"+to_string(now());write_file(tmp,t,true);rename_file(tmp,p)}
func canonical(v){if type(v)=="dict"{a:=[];for k in sort(keys(v)){a=push(a,to_json(k)+":"+canonical(v[k]))};return "{"+join(a,",")+"}"};if type(v)=="array"{a:=[];for x in v{a=push(a,canonical(x))};return "["+join(a,",")+"]"};return to_json(v)}
func state(p){return flag(p,"state",DEFAULT_STATE)}
func path(p,id){return join_path(join_path(state(p),"records"),id+".json")}
func init(p){d:=state(p);if file_exists(d)&&path_is_symlink(d){return {"ok":false,"error":"state directory symlinks are not allowed"}};tree(join_path(d,"records"));tree(join_path(d,"history"));m:=join_path(d,"metadata.json");if !path_is_file(m){atomic(m,to_json_pretty({"schema_version":"1.0.0","tool":SLUG,"tool_version":VERSION,"created_at":now_utc()}))};return {"ok":true,"value":{"initialized":true,"state":d}}}
func parse_object(text){mut v:=null;try {v=parse_json(text)} except err {return {"ok":false,"error":"malformed JSON"}};if type(v)!="dict"{return {"ok":false,"error":"input must be a JSON object"}};return {"ok":true,"value":v}}
func payload(p){f:=flag(p,"input","");if f==""{return {"ok":true,"value":{}}};if !path_is_file(f){return {"ok":false,"error":"input file not found"}};if path_is_symlink(f)||file_size(f)>1048576{return {"ok":false,"error":"unsafe or oversized input"}};parsed:=parse_object(read_file(f));if !parsed["ok"]{return parsed};v:=parsed["value"];s:=get(v,"schema_version","1.0.0");if type(s)!="string"||!starts_with(s,"1."){return {"ok":false,"error":"incompatible schema_version"}};return {"ok":true,"value":v}}
func domain(c,v,p){if SLUG=="dossier"&&(c=="evidence classify"||c=="verify"){cl:=get(v,"classification","");if cl!=""&&!has(["verified","observed","inferred","opinion","hypothesis","planned","conflicted","expired","unavailable","rejected"],cl){return "invalid evidence classification"};if cl=="verified"&&get(v,"captured_support","")==""{return "verified evidence requires captured support"}};if SLUG=="bluepencil"&&c=="review"{ver:=get(v,"verdict","unverified");if !has(["pass","pass_with_queries","revise","blocked","reject","unverified"],ver){return "invalid verdict"};if len(get(v,"blocking_findings",[]))>0&&(ver=="pass"||ver=="pass_with_queries"){return "blockers cannot be averaged away"}};if SLUG=="versionseal"&&c=="approve"{for k in ["human_actor","package_id","package_version","manifest_checksum","destination","action"]{if get(v,k,"")==""{return "approval missing "+k}};if flag(p,"actor","")!=v["human_actor"]{return "actor must match human_actor"}};if SLUG=="presswire"&&has(["publish","schedule","correct","unpublish"],c){if flag(p,"act",false)!=true||flag(p,"yes",false)!=true{return "effects require --act --yes"};if get(v,"approval_id","")==""||get(v,"manifest_checksum","")==""{return "approval evidence required"};if get(v,"authorized_action","")!=c{return "approval action mismatch"}};return ""}
func kind(c){a:=split(c," ");return a[0]}
func idprefix(c){if SLUG=="storydesk"{if kind(c)=="idea"{return "idea"};if kind(c)=="campaign"{return "campaign"};if kind(c)=="commission"{return "brief"};if c=="assign"{return "assignment"};if c=="handoff"{return "handoff"}};if SLUG=="dossier"&&has(["claim","source","evidence","rights"],kind(c)){return kind(c)};if SLUG=="galleypack"{if c=="build"||c=="freeze"{return "package"};return "artifact"};if SLUG=="bluepencil"{return "review"};if SLUG=="versionseal"{return "approval"};if SLUG=="presswire"{return "publication"};if SLUG=="readersignal"{if c=="learn"||c=="followup"{return "learning"};return "measurement"};if SLUG=="assetworks"{return "asset"};return PREFIX}
func create(c,p){i:=init(p);if !i["ok"]{return i};x:=payload(p);if !x["ok"]{return x};v:=x["value"];e:=domain(c,v,p);if e!=""{return {"ok":false,"error":e}};actor:=flag(p,"actor","");if actor==""{return {"ok":false,"error":"mutating commands require --actor"}};ts:=flag(p,"timestamp",now_utc());pre:=idprefix(c);id:=flag(p,"id","");if id==""{id=pre+"-"+substring(sha256(SLUG+"\n"+c+"\n"+actor+"\n"+ts+"\n"+canonical(v)),0,20)};if !safe(id)||!starts_with(id,pre+"-"){return {"ok":false,"error":"invalid id prefix"}};dest:=path(p,id);if path_is_file(dest){return {"ok":false,"error":"duplicate record id"}};r:={"schema_version":"1.0.0","tool_version":VERSION,"id":id,"record_type":kind(c),"command":c,"actor":actor,"created_at":ts,"provenance":get(v,"provenance",[]),"payload":v};artifact:=flag(p,"path","");if artifact!=""{if !path_is_file(artifact)||path_is_symlink(artifact)||file_size(artifact)>67108864{return {"ok":false,"error":"unsafe artifact"}};r["artifact"]={"path":artifact,"sha256":sha256_file(artifact),"bytes":file_size(artifact)}};if flag(p,"dry-run",false)==true{return {"ok":true,"value":{"dry_run":true,"record":r}}};atomic(dest,to_json_pretty(r));atomic(join_path(state(p),"history/"+substring(sha256(ts+id),0,24)+".json"),to_json_pretty({"schema_version":"1.0.0","event":"record.created","record_id":id,"actor":actor,"at":ts,"checksum":sha256(canonical(r))}));return {"ok":true,"value":r}}
func load(p,id){if !safe(id){return {"ok":false,"error":"unsafe record id"}};f:=path(p,id);if !path_is_file(f)||path_is_symlink(f){return {"ok":false,"error":"record not found"}};v:=parse_json(read_file(f));if type(v)!="dict"{return {"ok":false,"error":"malformed record"}};return {"ok":true,"value":v}}
func list(p){a:=[];d:=join_path(state(p),"records");if !path_is_dir(d){return a};for n in sort(list_dir(d)){if ends_with(n,".json")&&!path_is_symlink(join_path(d,n)){v:=parse_json(read_file(join_path(d,n)));if type(v)=="dict"{a=push(a,v)};if len(a)>=1000{return a}}};return a}
func verify(p){l:=load(p,flag(p,"id",""));if !l["ok"]{return l};f:=flag(p,"path","");if f!=""{expected:=get(get(l["value"],"artifact",{}),"sha256",get(l["value"]["payload"],"manifest_checksum",""));if !path_is_file(f)||expected==""||sha256_file(f)!=expected{return {"ok":false,"error":"checksum drift detected"}}};return {"ok":true,"value":{"valid":true,"record_id":l["value"]["id"],"checksum":sha256(canonical(l["value"]))}}}
export func dispatch(c,p){if c=="init"{return init(p)};if c=="version"{return {"ok":true,"value":{"tool":SLUG,"version":VERSION,"kujo_version":"1.0.1"}}};if c=="doctor"{return {"ok":true,"value":{"healthy":true,"state":state(p),"kujo_version":"1.0.1","limitations":"GalleyPack validates and freezes exact files but does not modify sources, approve, or publish."}}};if c=="show"||c=="claim show"||c=="receipt"||c=="inspect"{return load(p,flag(p,"id",""))};if has(["validate","verify","freshness check","status"],c){return verify(p)};if has(["list","idea list","review-queue","history","report","signals","adapters","capabilities","disagreements"],c){a:=list(p);return {"ok":true,"value":{"records":a,"count":len(a)}}};if c=="export"{return {"ok":true,"value":{"schema_version":"1.0.0","tool":SLUG,"records":list(p)}}};return create(c,p)}
func cname(a){if len(a)==0{return "help"};if len(a)>1&&has(COMMANDS,a[0]+" "+a[1]){return a[0]+" "+a[1]};return a[0]}
func tokens(a,c){if contains(c," ")==1{return slice(a,2,len(a))};return slice(a,1,len(a))}
func env(ok,data,error){return {"ok":ok,"data":data,"error":error,"tool_version":VERSION,"contract_version":CONTRACT}}
export func main(a) {
    c := cname(a)
    if c == "help" { print(NAME + " " + VERSION + "\n\nCommands:\n  " + join(COMMANDS, "\n  ") + "\n\nFlags: --state --input --id --actor --timestamp --path --json --dry-run --output --config --force"); return 0 }
    if !has(COMMANDS, c) { eprint(NAME + ": unknown command: " + c); return 2 }
    p := parse_args(tokens(a, c), ["json", "dry-run", "force", "act", "yes"])
    if len(p["errors"]) > 0 { eprint(NAME + ": " + p["errors"][0]); return 2 }
    allowed := ["state", "input", "id", "actor", "timestamp", "path", "json", "dry-run", "output", "config", "force", "act", "yes"]
    for k in keys(p["flags"]) { if !has(allowed, k) { eprint(NAME + ": unknown flag --" + k); return 2 } }
    r := dispatch(c, p)
    out := env(r["ok"], get(r, "value", null), get(r, "error", null))
    if flag(p, "json", false) { print(to_json_pretty(out)) }
    else if r["ok"] { print(NAME + ": ok\n" + to_json_pretty(get(r, "value", null))) }
    else { eprint(NAME + ": " + r["error"]) }
    if r["ok"] { return 0 }
    return 1
}
