from src.common import get, has, canonical_json, find_sensitive_key

func safe_relative(path){if type(path)!="string"||trim(path)==""||starts_with(path,"/")||contains(path,"\\"){return false};for part in split(path,"/"){if part==""||part=="."||part==".."{return false}};return true}
func ensure_tree(path){parts:=split(path,"/");mut current:="";if starts_with(path,"/"){current="/"};for part in parts{if part!=""{if current=="/"{current="/"+part}else if current==""{current=part}else{current=current+"/"+part};if !file_exists(current){create_dir(current)}else if !path_is_dir(current){return false}}};return true}

export func materialize_review_package(manifest,output_root){entries:=get(manifest,"entries",[]);if type(entries)!="array"||len(entries)==0||len(entries)>1000{return {"ok":false,"error":"manifest entries must contain 1..1000 files"}};if file_exists(output_root){return {"ok":false,"error":"output root must not already exist"}};if !ensure_tree(output_root){return {"ok":false,"error":"could not create safe output root"}};mut written:=[];for entry in entries{relative:=get(entry,"path","");content:=get(entry,"content",null);if !safe_relative(relative)||type(content)!="string"||len(content)>1048576{return {"ok":false,"error":"entry path/content is unsafe or exceeds 1 MiB"}};target:=output_root+"/"+relative;if !ensure_tree(dirname(target)){return {"ok":false,"error":"could not create package directory"}};write_file_atomic(target,content,true);written=push(written,{"path":relative,"bytes":len(content),"sha256":sha256(content)})};return {"ok":true,"root":output_root,"entries":written,"tree_sha256":sha256(canonical_json(written))}}

export func checksum_manifest(entries,signing_key){if type(entries)!="array"||len(entries)==0||len(entries)>10000{return {"ok":false,"error":"entries must contain 1..10000 checksums"}};for entry in entries{if !safe_relative(get(entry,"path",""))||!regex_match(get(entry,"sha256",""),"^[a-f0-9]{64}$"){return {"ok":false,"error":"invalid checksum entry"}}};payload:=canonical_json(entries);receipt:={"ok":true,"algorithm":"sha256","tree_sha256":sha256(payload),"entries":len(entries)};if type(signing_key)=="string"&&signing_key!=""{if len(signing_key)<16{return {"ok":false,"error":"signing key must contain at least 16 bytes"}};receipt["signature_algorithm"]="hmac-sha256";receipt["signature"]=hmac_sha256(signing_key,payload)};return receipt}

export func streaming_tree_hash(root,relative_paths,maximum_files){if !path_is_dir(root)||path_is_symlink(root)||maximum_files<1||maximum_files>100000||type(relative_paths)!="array"||len(relative_paths)>maximum_files{return {"ok":false,"error":"tree root or file-count bound is invalid"}};mut entries:=[];for relative in sort(relative_paths){if !safe_relative(relative){return {"ok":false,"error":"unsafe tree path"}};path:=root+"/"+relative;if !path_is_file(path)||path_is_symlink(path){return {"ok":false,"error":"tree entry is missing or unsafe"}};entries=push(entries,{"path":relative,"bytes":file_size(path),"sha256":sha256_file(path)})};manifest:=checksum_manifest(entries,"");manifest["streaming"]=true;manifest["files"]=len(entries);return manifest}

export func archive_adapter_plan(format,entries,adapter){if !has(["tar","zip"],format){return {"ok":false,"error":"archive format must be tar or zip"}};if type(entries)!="array"||len(entries)==0||len(entries)>10000{return {"ok":false,"error":"archive entries must contain 1..10000 files"}};if type(adapter)!="dict"||get(adapter,"offline",false)!=true||get(adapter,"normalizes_timestamps",false)!=true||get(adapter,"sorts_entries",false)!=true{return {"ok":false,"error":"adapter must prove offline deterministic ordering and timestamp normalization"}};return {"ok":true,"format":format,"entries":sort(entries),"mtime":"1970-01-01T00:00:00Z","uid":0,"gid":0,"adapter":get(adapter,"id",""),"reproducible":true}}

export func object_store_conformance(adapter){if type(adapter)!="dict"||get(adapter,"offline_fixture",false)!=true||get(adapter,"implicit_credentials",true)!=false{return {"ok":false,"error":"object-store adapter must use offline fixtures and reject implicit credentials"}};operations:=get(adapter,"operations",[]);for required in ["put","head","get"]{if !has(operations,required){return {"ok":false,"error":"missing object-store operation: "+required}}};return {"ok":true,"conformant":true,"adapter":get(adapter,"id","")}}

export func local_claim_delta(left,right){if type(left)!="dict"||type(right)!="dict"{return {"ok":false,"error":"claim sets must be objects"}};mut added:=[];mut removed:=[];mut changed:=[];for key in sort(keys(right)){if has_key(left,key)==0{added=push(added,key)}else if canonical_json(left[key])!=canonical_json(right[key]){changed=push(changed,key)}};for key in sort(keys(left)){if has_key(right,key)==0{removed=push(removed,key)}};return {"ok":true,"added":added,"removed":removed,"changed":changed,"deterministic":true}}
export func semantic_delta(left,right,receipt){local:=local_claim_delta(left,right);if !local["ok"]{return local};if type(receipt)!="dict"||get(receipt,"offline",false)!=true||find_sensitive_key(receipt,"")!=""{return {"ok":false,"error":"semantic adapter requires a redacted offline receipt"}};return {"ok":true,"local":local,"semantic":get(receipt,"semantic",[]),"local_path_preserved":true}}
