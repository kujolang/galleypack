from src.common import get, has, canonical_json, find_sensitive_key, utf8_size, is_symlink

func safe_relative(path) {
    if type(path) != "string" || trim(path) == "" || starts_with(path, "/") || contains(path, "\\") || regex_match(path, "[\\x00-\\x1F\\x7F]") { return false }
    for part in split(path, "/") { if part == "" || part == "." || part == ".." { return false } }
    return true
}

// Reject ambiguous manifests before any filesystem effects or adapter handoff.
func validate_paths(paths) {
    mut seen := {}; mut directories := {}
    for path in paths {
        if !safe_relative(path) { return "unsafe relative path" }
        if has_key(seen, path) == 1 || has_key(directories, path) == 1 { return "duplicate path or file/directory collision" }
        mut parent := ""
        parts := split(path, "/")
        for part in slice(parts, 0, len(parts) - 1) {
            if parent == "" { parent = part } else { parent = parent + "/" + part }
            if has_key(seen, parent) == 1 { return "file/directory collision" }
            directories[parent] = true
        }
        seen[path] = true
    }
    return ""
}

func safe_tree_file(root, relative) {
    mut current := root
    for part in split(relative, "/") {
        current = current + "/" + part
        if is_symlink(current) { return false }
    }
    return path_is_file(current)
}

export func materialize_review_package(manifest, output_root) {
    entries := get(manifest, "entries", [])
    if type(entries) != "array" || len(entries) == 0 || len(entries) > 1000 { return {"ok": false, "error": "manifest entries must contain 1..1000 files"} }
    if type(output_root) != "string" || trim(output_root) == "" { return {"ok": false, "error": "output root is invalid"} }
    while len(output_root) > 1 && ends_with(output_root, "/") { output_root = substring(output_root, 0, len(output_root) - 1) }
    for part in split(replace_str(output_root, "\\", "/"), "/") { if part == ".." { return {"ok": false, "error": "output root traversal is not allowed"} } }
    if file_exists(output_root) || is_symlink(output_root) { return {"ok": false, "error": "output root must not already exist"} }
    mut paths := []; mut total := 0
    for entry in entries {
        content := get(entry, "content", null)
        if type(content) != "string" { return {"ok": false, "error": "entry content must be a string"} }
        size := utf8_size(content)
        if size > 1048576 { return {"ok": false, "error": "entry content exceeds 1 MiB"} }
        total = total + size
        if total > 67108864 { return {"ok": false, "error": "package content exceeds 64 MiB"} }
        paths = push(paths, get(entry, "path", ""))
    }
    invalid := validate_paths(paths); if invalid != "" { return {"ok": false, "error": invalid} }
    // Serialize cooperating materializers without trusting recursive create_dir as a lock.
    lock := output_root + ".galleypack-lock"
    try { create_dir(dirname(output_root)); write_file_atomic(lock, "locked\n", false) }
    except error { return {"ok": false, "error": "could not reserve package output: " + to_string(error)} }
    if file_exists(output_root) || is_symlink(output_root) { delete_file(lock); return {"ok": false, "error": "output root must not already exist"} }
    mut written := []
    try {
        create_dir(output_root)
        for entry in entries {
            target := output_root + "/" + entry["path"]
            mut current := output_root
            parts := split(entry["path"], "/")
            for part in slice(parts, 0, len(parts) - 1) {
                current = current + "/" + part
                if is_symlink(current) { throw("package directory symlink is not allowed") }
                create_dir(current)
            }
            write_file_atomic(target, entry["content"], false)
            written = push(written, {"path": entry["path"], "bytes": utf8_size(entry["content"]), "sha256": sha256(entry["content"])})
        }
    } except error { delete_file(lock); return {"ok": false, "error": "package write failed: " + to_string(error), "root": output_root, "entries": written} }
    delete_file(lock)
    return {"ok": true, "root": output_root, "entries": written, "tree_sha256": sha256(canonical_json(written))}
}

func manifest_receipt(payload, count, signing_key) {
    receipt := {"ok": true, "algorithm": "sha256", "tree_sha256": sha256(payload), "entries": count}
    if signing_key != "" { receipt["signature_algorithm"] = "hmac-sha256"; receipt["signature"] = hmac_sha256(signing_key, payload) }
    return receipt
}

export func checksum_manifest(entries, signing_key) {
    if type(entries) != "array" || len(entries) == 0 || len(entries) > 10000 { return {"ok": false, "error": "entries must contain 1..10000 checksums"} }
    if type(signing_key) != "string" || (signing_key != "" && utf8_size(signing_key) < 16) { return {"ok": false, "error": "signing key must be empty or contain at least 16 bytes"} }
    mut paths := []
    for entry in entries {
        digest := get(entry, "sha256", "")
        if type(digest) != "string" || !regex_match(digest, "^[a-f0-9]{64}$") { return {"ok": false, "error": "invalid checksum entry"} }
        paths = push(paths, get(entry, "path", ""))
    }
    invalid := validate_paths(paths); if invalid != "" { return {"ok": false, "error": invalid} }
    return manifest_receipt(canonical_json(entries), len(entries), signing_key)
}

export func streaming_tree_hash(root, relative_paths, maximum_files) {
    if type(root) != "string" || !path_is_dir(root) || is_symlink(root) || type(maximum_files) != "int" || maximum_files < 1 || maximum_files > 100000 || type(relative_paths) != "array" || len(relative_paths) == 0 || len(relative_paths) > maximum_files { return {"ok": false, "error": "tree root or file-count bound is invalid"} }
    invalid := validate_paths(relative_paths); if invalid != "" { return {"ok": false, "error": invalid} }
    mut entries := []; mut total := 0
    try {
        for relative in sort(relative_paths) {
            if !safe_tree_file(root, relative) { return {"ok": false, "error": "tree entry is missing or unsafe"} }
            path := root + "/" + relative; size := file_size(path)
            total = total + size
            if size > 67108864 || total > 1073741824 { return {"ok": false, "error": "tree exceeds 64 MiB per file or 1 GiB total"} }
            entries = push(entries, {"path": relative, "bytes": size, "sha256": sha256_file(path)})
        }
    } except error { return {"ok": false, "error": "tree hash failed: " + to_string(error)} }
    // These internally constructed rows contain only string keys and scalar values.
    // Kujo JSON sorts object keys; this is byte-equivalent to canonical_json here.
    manifest := manifest_receipt(to_json(entries), len(entries), "")
    manifest["streaming"] = true; manifest["files"] = len(entries)
    return manifest
}

export func archive_adapter_plan(format, entries, adapter) {
    if !has(["tar", "zip"], format) { return {"ok": false, "error": "archive format must be tar or zip"} }
    if type(entries) != "array" || len(entries) == 0 || len(entries) > 10000 { return {"ok": false, "error": "archive entries must contain 1..10000 files"} }
    invalid := validate_paths(entries); if invalid != "" { return {"ok": false, "error": invalid} }
    if type(adapter) != "dict" || get(adapter, "offline", false) != true || get(adapter, "normalizes_timestamps", false) != true || get(adapter, "sorts_entries", false) != true { return {"ok": false, "error": "adapter must prove offline deterministic ordering and timestamp normalization"} }
    return {"ok": true, "format": format, "entries": sort(entries), "mtime": "1970-01-01T00:00:00Z", "uid": 0, "gid": 0, "adapter": get(adapter, "id", ""), "reproducible": true}
}

export func object_store_conformance(adapter) {
    if type(adapter) != "dict" || get(adapter, "offline_fixture", false) != true || get(adapter, "implicit_credentials", true) != false { return {"ok": false, "error": "object-store adapter must use offline fixtures and reject implicit credentials"} }
    operations := get(adapter, "operations", [])
    if type(operations) != "array" { return {"ok": false, "error": "object-store operations must be an array"} }
    for required in ["put", "head", "get"] { if !has(operations, required) { return {"ok": false, "error": "missing object-store operation: " + required} } }
    return {"ok": true, "conformant": true, "adapter": get(adapter, "id", "")}
}

export func local_claim_delta(left, right) {
    if type(left) != "dict" || type(right) != "dict" { return {"ok": false, "error": "claim sets must be objects"} }
    mut added := []; mut removed := []; mut changed := []
    for key in sort(keys(right)) { if has_key(left, key) == 0 { added = push(added, key) } else if canonical_json(left[key]) != canonical_json(right[key]) { changed = push(changed, key) } }
    for key in sort(keys(left)) { if has_key(right, key) == 0 { removed = push(removed, key) } }
    return {"ok": true, "added": added, "removed": removed, "changed": changed, "deterministic": true}
}

export func semantic_delta(left, right, receipt) {
    local := local_claim_delta(left, right); if !local["ok"] { return local }
    if type(receipt) != "dict" || get(receipt, "offline", false) != true || find_sensitive_key(receipt, "") != "" { return {"ok": false, "error": "semantic adapter requires a redacted offline receipt"} }
    return {"ok": true, "local": local, "semantic": get(receipt, "semantic", []), "local_path_preserved": true}
}
