from src.common import get, parse_object, safe_id, utf8_size, is_symlink

func ensure_tree(path) {
    if path == "" || path == "." { return "" }
    parts := split(path, "/"); mut current := ""; if starts_with(path, "/") { current = "/" }
    for part in parts {
        if part != "" && part != "." {
            if part == ".." { return "path traversal is not allowed" }
            if current == "/" { current = "/" + part } else if current == "" { current = part } else { current = current + "/" + part }
            if file_exists(current) {
                if !path_is_dir(current) { return "path component is not a directory: " + current }
            } else { try { create_dir(current) } except error { return "could not create directory: " + current } }
        }
    }
    return ""
}

export func validate_state_path(path) {
    if type(path) != "string" || trim(path) == "" { return "state path is empty or invalid" }
    for part in split(replace_str(path, "\\", "/"), "/") { if part == ".." { return "state path traversal is not allowed" } }
    if is_symlink(path) { return "state directory symlinks are not allowed" }
    if file_exists(path) && !path_is_dir(path) { return "state path is not a directory" }
    return ""
}

export func records_dir(state) { return join_path(state, "records") }
export func history_dir(state) { return join_path(state, "history") }
func locks_dir(state) { return join_path(state, "locks") }
export func record_path(state, id) { return join_path(records_dir(state), id + ".json") }

export func inspect_state(state, metadata) {
    error := validate_state_path(state); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }
    for dir in [records_dir(state), history_dir(state), locks_dir(state)] {
        if is_symlink(dir) || (file_exists(dir) && !path_is_dir(dir)) { return {"ok": false, "code": "unsafe_state", "error": "managed state paths must be regular directories"} }
    }
    path := join_path(state, "metadata.json")
    if is_symlink(path) { return {"ok": false, "code": "unsafe_state", "error": "metadata must be a regular non-symlink file"} }
    if file_exists(path) {
        if !path_is_file(path) { return {"ok": false, "code": "unsafe_state", "error": "metadata must be a regular file"} }
        if file_size(path) > 65536 { return {"ok": false, "code": "metadata_too_large", "error": "metadata exceeds 64 KiB"} }
        parsed := parse_object(read_file(path), "state metadata"); if !parsed["ok"] { return parsed }
        existing := parsed["value"]
        if get(existing, "tool", "") != get(metadata, "tool", "") || get(existing, "contract_version", "") != get(metadata, "contract_version", "") { return {"ok": false, "code": "incompatible_state", "error": "state metadata belongs to an incompatible tool or contract"} }
    }
    return {"ok": true}
}

export func initialize(state, metadata) {
    checked := inspect_state(state, metadata); if !checked["ok"] { return checked }
    for dir in [records_dir(state), history_dir(state), locks_dir(state)] {
        error := ensure_tree(dir); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }
    }
    path := join_path(state, "metadata.json")
    if !file_exists(path) {
        try { write_file_atomic(path, to_json_pretty(metadata) + "\n", false) } except error {
            // A concurrent initializer may win; inspect once, without recursive retries.
            if !path_is_file(path) { return {"ok": false, "code": "write_failed", "error": "could not initialize state metadata"} }
            winner := inspect_state(state, metadata); if !winner["ok"] { return winner }
        }
    }
    return {"ok": true, "value": {"state": state, "initialized": true}}
}

func lock_path(state, id) { return join_path(locks_dir(state), id + ".lock") }

func acquire_lock(state, id) {
    path := lock_path(state, id)
    try { write_file_atomic(path, "locked\n", false) } except error { return {"ok": false, "code": "write_conflict", "error": "could not acquire record lock: " + id} }
    return {"ok": true, "path": path}
}

func release_lock(path) { delete_file(path) }

func save_locked(state, record) {
    id := record["id"]
    if !safe_id(id) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    path := record_path(state, id)
    if path_is_file(path) { return {"ok": false, "code": "duplicate_id", "error": "record already exists: " + id} }
    if is_symlink(path) { return {"ok": false, "code": "symlink_escape", "error": "record symlinks are not allowed"} }
    serialized := to_json_pretty(record) + "\n"
    if utf8_size(serialized) > 1048576 { return {"ok": false, "code": "record_too_large", "error": "serialized record exceeds 1 MiB"} }
    checksum := sha256(serialized)
    event := {"schema_version": "1.0.0", "event": "record.created", "record_id": id, "actor": record["actor"], "at": record["created_at"], "record_sha256": checksum}
    event_path := join_path(history_dir(state), substring(sha256(record["created_at"] + "\n" + id), 0, 32) + ".json")
    if file_exists(event_path) { return {"ok": false, "code": "history_conflict", "error": "audit history event already exists"} }
    try { write_file_atomic(path, serialized, false) } except error { return {"ok": false, "code": "write_failed", "error": "atomic record write failed"} }
    try { write_file_atomic(event_path, to_json_pretty(event) + "\n", false) } except error {
        try { delete_file(path) } except rollback_error {}
        if path_is_file(path) { return {"ok": false, "code": "history_write_failed", "error": "audit history write failed and record rollback was incomplete"} }
        return {"ok": false, "code": "history_write_failed", "error": "audit history write failed; record write was rolled back"}
    }
    return {"ok": true, "value": {"path": path, "checksum": checksum}}
}

export func save_new(state, record) {
    if type(record) != "dict" || !safe_id(get(record, "id", "")) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    if type(get(record, "actor", null)) != "string" || type(get(record, "created_at", null)) != "string" { return {"ok": false, "code": "invalid_record", "error": "record actor and created_at must be strings"} }
    error := validate_state_path(state); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }
    for dir in [records_dir(state), history_dir(state), locks_dir(state)] {
        if !path_is_dir(dir) || is_symlink(dir) { return {"ok": false, "code": "unsafe_state", "error": "initialize regular managed state directories before writing"} }
    }
    lock := acquire_lock(state, record["id"]); if !lock["ok"] { return lock }
    mut result := {}
    try { result = save_locked(state, record) } except error { result = {"ok": false, "code": "write_failed", "error": to_string(error)} }
    try { release_lock(lock["path"]) } except error {
        return {"ok": false, "code": "lock_cleanup_failed", "error": "record operation completed but its lock could not be removed: " + to_string(error), "value": {"operation_result": result}}
    }
    return result
}

func read_record_file(state, id, checksum_required) {
    if !safe_id(id) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    path := record_path(state, id)
    if !path_is_file(path) || is_symlink(path) { return {"ok": false, "code": "not_found", "error": "record not found: " + id} }
    size := file_size(path)
    if size > 1048576 { return {"ok": false, "code": "record_too_large", "error": "record exceeds 1 MiB"} }
    contents := read_file(path); parsed := parse_object(contents, "record " + id); if !parsed["ok"] { return parsed }
    if get(parsed["value"], "id", "") != id { return {"ok": false, "code": "id_mismatch", "error": "record id does not match filename"} }
    result := {"ok": true, "value": parsed["value"], "bytes": size}
    if checksum_required { result["checksum"] = sha256(contents) }
    return result
}

export func load_record(state, id) {
    state_error := validate_state_path(state); if state_error != "" { return {"ok": false, "code": "unsafe_state", "error": state_error} }
    dir := records_dir(state); if file_exists(dir) && (is_symlink(dir) || !path_is_dir(dir)) { return {"ok": false, "code": "unsafe_state", "error": "records path must be a regular directory"} }
    return read_record_file(state, id, true)
}

export func list_records(state, kind, after, limit) {
    mut records := []; mut warnings := []; mut truncated := false
    mut scanned := 0; mut total_bytes := 0; mut next_after := after
    state_error := validate_state_path(state)
    if state_error != "" { return {"records": records, "warnings": [{"id": "", "code": "unsafe_state", "error": state_error}], "truncated": false, "next_after": after} }
    dir := records_dir(state)
    if is_symlink(dir) || (file_exists(dir) && !path_is_dir(dir)) { return {"records": records, "warnings": [{"id": "", "code": "unsafe_state", "error": "records path must be a regular directory"}], "truncated": false, "next_after": after} }
    if !path_is_dir(dir) { return {"records": records, "warnings": warnings, "truncated": false, "next_after": after} }
    // Directory enumeration remains eager in Kujo; bound parsing, hashing and retained data.
    for name in sort(list_dir(dir)) {
        if ends_with(name, ".json") {
            id := substring(name, 0, len(name) - 5)
            if after == "" || id > after {
                if scanned >= 1000 || len(records) >= limit { truncated = true; break }
                loaded := read_record_file(state, id, false)
                if loaded["ok"] {
                    record := loaded["value"]
                    if kind == "" || get(record, "record_type", "") == kind {
                        if total_bytes + loaded["bytes"] > 4194304 { truncated = true; break }
                        total_bytes = total_bytes + loaded["bytes"]
                        records = push(records, record)
                    }
                } else { warnings = push(warnings, {"id": id, "code": loaded["code"], "error": loaded["error"]}) }
                scanned = scanned + 1
                next_after = id
            }
        }
    }
    return {"records": records, "warnings": warnings, "truncated": truncated, "next_after": next_after, "scanned": scanned}
}
