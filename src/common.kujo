export func get(value, key, fallback) {
    if type(value) == "dict" && has_key(value, key) == 1 { return value[key] }
    return fallback
}

export func has(values, wanted) {
    for value in values { if value == wanted { return true } }
    return false
}

export func canonical_json(value) {
    if type(value) == "dict" {
        mut members := []
        for key in sort(keys(value)) { members = push(members, to_json(key) + ":" + canonical_json(value[key])) }
        return "{" + join(members, ",") + "}"
    }
    if type(value) == "array" {
        mut members := []
        for item in value { members = push(members, canonical_json(item)) }
        return "[" + join(members, ",") + "]"
    }
    return to_json(value)
}

export func parse_object(text, label) {
    mut value := null
    try { value = parse_json(text) } except error { return {"ok": false, "code": "malformed_json", "error": label + " is not valid JSON"} }
    if type(value) != "dict" { return {"ok": false, "code": "invalid_shape", "error": label + " must be a JSON object"} }
    return {"ok": true, "value": value}
}

export func safe_id(value) {
    return type(value) == "string" && regex_match(value, "^[a-z][a-z0-9-]{2,127}$") && value != "." && value != ".."
}

export func valid_timestamp(value) {
    if !(type(value) == "string" && regex_match(value, "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$")) { return false }
    year := to_int(substring(value, 0, 4)); month := to_int(substring(value, 5, 7)); day := to_int(substring(value, 8, 10))
    days := [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    maximum := days[month - 1]
    if month == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { maximum = 29 }
    return day <= maximum
}

func sensitive_name(name) {
    normalized := lower(replace_str(replace_str(name, "-", "_"), " ", "_"))
    return regex_match(normalized, "(^|_)(password|passwd|secret|token|api_key|apikey|authorization|private_key|client_secret|access_key)($|_)")
}

export func find_sensitive_key(value, path) {
    if type(value) == "dict" {
        for key in keys(value) {
            if sensitive_name(key) { return path + key }
            found := find_sensitive_key(value[key], path + key + ".")
            if found != "" { return found }
        }
    }
    if type(value) == "array" {
        mut index := 0
        for item in value {
            found := find_sensitive_key(item, path + to_string(index) + ".")
            if found != "" { return found }
            index = index + 1
        }
    }
    return ""
}

export func bounded_int(value, fallback, minimum, maximum) {
    if type(value) == "null" || value == "" { return {"ok": true, "value": fallback} }
    text := to_string(value)
    if !regex_match(text, "^[0-9]+$") { return {"ok": false, "code": "invalid_number", "error": "expected an integer"} }
    if len(text) > 18 { return {"ok": false, "code": "out_of_range", "error": "integer exceeds supported range"} }
    number := to_int(text)
    if number < minimum || number > maximum { return {"ok": false, "code": "out_of_range", "error": "value must be " + to_string(minimum) + ".." + to_string(maximum)} }
    return {"ok": true, "value": number}
}

export func envelope(ok, data, error, code, version, contract) {
    return {"ok": ok, "data": data, "error": error, "error_code": code, "tool_version": version, "contract_version": contract}
}

// Kujo 1.0.1 has character-count len, but no byte_length builtin.
export func utf8_size(text) {
    encoded := encode_base64(text)
    count := to_int(len(encoded) / 4) * 3
    if ends_with(encoded, "==") { return count - 2 }
    if ends_with(encoded, "=") { return count - 1 }
    return count
}

// lstat rejects missing paths in Kujo 1.0.1. Check directory entries to distinguish
// an absent leaf from a dangling link without swallowing metadata/permission errors.
export func is_symlink(path) {
    if file_exists(path) { return path_is_symlink(path) }
    parent := dirname(path)
    if !path_is_dir(parent) { return false }
    if has(list_dir(parent), basename(path)) { return path_is_symlink(path) }
    return false
}
