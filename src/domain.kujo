from src.common import get, has, safe_id
export func record_type(command){if command=="add"{return "artifact"};if command=="relate"{return "artifact_relationship"};if command=="evidence attach"{return "evidence_attachment"};if command=="review attach"{return "review_attachment"};if command=="build"||command=="freeze"{return "package_version"};return replace_str(command," ","_")}
export func id_prefix(command){kind:=record_type(command);if kind=="artifact_relationship"{return "relationship"};if kind=="evidence_attachment"{return "evidence-link"};if kind=="review_attachment"{return "review-link"};if kind=="package_version"{return "package"};return replace_str(kind,"_","-")}
func require_text(payload,key){value:=get(payload,key,"");if type(value)!="string"||trim(value)==""{return "missing required field: "+key};if len(value)>16384{return "field exceeds 16 KiB: "+key};return ""}
func require_id(payload,key){error:=require_text(payload,key);if error!=""{return error};if !safe_id(payload[key]){return "invalid record reference: "+key};return ""}
func valid_ids(value){if type(value)!="array"||len(value)==0||len(value)>1000{return false};for id in value{if !safe_id(id){return false}};return true}
export func validate_command(command,payload,artifact){
    if command=="add"{if type(artifact)!="dict"{return "add requires --path"};return require_text(payload,"artifact_kind")}
    if command=="relate"{for key in ["artifact_id","related_artifact_id"]{error:=require_id(payload,key);if error!=""{return error}};error:=require_text(payload,"relationship");if error!=""{return error};if payload["artifact_id"]==payload["related_artifact_id"]{return "artifact cannot relate to itself"};if !has(["source","derivative","adaptation","variant","replacement"],payload["relationship"]){return "invalid artifact relationship"}}
    if command=="evidence attach"{for key in ["artifact_id","evidence_id"]{error:=require_id(payload,key);if error!=""{return error}}}
    if command=="review attach"{for key in ["package_id","review_id"]{error:=require_id(payload,key);if error!=""{return error}};error:=require_text(payload,"verdict");if error!=""{return error}}
    if command=="build"||command=="freeze"{error:=require_id(payload,"package_id");if error!=""{return error};error=require_text(payload,"package_version");if error!=""{return error};if !valid_ids(get(payload,"artifact_ids",null)){return "package requires 1..1000 safe artifact_ids"};if type(artifact)!="dict"{return command+" requires --path to the exact manifest or package artifact"}}
    return ""
}
