#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -z "${KUJO_BIN:-}" ]; then
    if command -v kujo >/dev/null 2>&1; then
        KUJO_BIN=$(command -v kujo)
    else
        KUJO_BIN="$ROOT/../kujo/target/release/kujo"
    fi
fi
case "$KUJO_BIN" in
    */*) ;;
    *) KUJO_BIN=$(command -v "$KUJO_BIN" 2>/dev/null || true) ;;
esac
if [ ! -x "$KUJO_BIN" ]; then
    printf 'GalleyPack: Kujo runtime not found; set KUJO_BIN.\n' >&2
    exit 2
fi
exec "$KUJO_BIN" run "$ROOT/galleypack.kujo" -- "$@"
